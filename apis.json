{
  "_comment": "Web services checked on https://ices-tools-prod.github.io/apis.html. Each API has an id (used for its page and baseline file), a name, a base url, the packages that call it directly, and a list of endpoints. Each endpoint has a name, a path (with example query values, appended to the base url) and the R functions that call it. The response of each endpoint is compared with the baseline in api-baselines/<id>.json, see the README.",
  "apis": [
    {
      "id": "sag",
      "name": "Stock Assessment Graphs (SAG)",
      "description": "Stock assessment summaries, reference points and stock status from the ICES Stock Assessment Graphs database.",
      "base_url": "https://sag.ices.dk/SAG_API/api",
      "website": "https://sag.ices.dk",
      "packages": ["icesSAG"],
      "endpoints": [
        {
          "name": "StockList",
          "path": "StockList?year=2024",
          "functions": ["getListStocks", "findAssessmentKey"]
        },
        {
          "name": "StockList, by stock",
          "path": "StockList?year=2024&fishStock=ple.27.420",
          "functions": ["getListStocks"]
        },
        {
          "name": "LatestStockAdviceList",
          "path": "LatestStockAdviceList",
          "functions": ["getLatestStockAdviceList"]
        },
        {
          "name": "SummaryTable",
          "path": "SummaryTable?assessmentKey=18688",
          "functions": ["getSummaryTable", "getSAG"]
        },
        {
          "name": "StockStatusValues",
          "path": "StockStatusValues?assessmentKey=18688",
          "functions": ["getStockStatusValues"]
        },
        {
          "name": "FishStockReferencePoints",
          "path": "FishStockReferencePoints?assessmentKey=18688",
          "functions": ["getFishStockReferencePoints"]
        },
        {
          "name": "StockDownload",
          "path": "StockDownload?assessmentKey=18688",
          "functions": ["getStockDownloadData"]
        },
        {
          "name": "StockSettings",
          "path": "StockSettings?assessmentKey=18688",
          "functions": ["getSAGSettingsForAStock"]
        },
        {
          "name": "SAGTypeCharts",
          "path": "SAGTypeCharts",
          "functions": ["getSAGTypeGraphs"]
        },
        {
          "name": "SettingsForChartType",
          "path": "SettingsForChartType?SAGChartKey=1",
          "functions": ["getSAGTypeSettings"]
        }
      ]
    }
  ]
}
